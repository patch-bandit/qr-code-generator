{
  "name": "bandit-codes",
  "version": "1.1.0",
  "description": "Free, private QR code generator. Everything runs in your browser or your terminal.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "bandit-codes": "dist/cli.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "tsup",
    "schema": "tsx scripts/make-schema.ts",
    "test": "vitest run",
    "mutation-proof": "node scripts/mutation-proof.mjs",
    "check:offline": "node scripts/run-check.mjs scripts/offline-check.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@zxing/library": "0.23.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
